<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>SleepWallpaper</AssemblyName>
    <RootNamespace>SleepWallpaper</RootNamespace>
    <Product>Sleep Wallpaper</Product>
    <ApplicationIcon>SleepWallpaper.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="SleepWallpaper.ico" />
  </ItemGroup>
</Project>
